  "components": {
    "schemas": {
      "AccountInfo": {"type": "object", "properties": {"_account_id": {"type": "integer", "description": "The numeric ID of the account."}, "name": {"type": "string", "description": "The full name of the user. + Only set if detailed account information is requested. + See option DETAILED_ACCOUNTS for change queries + and option DETAILS for account queries."}, "display_name": {"type": "string", "description": "The display name of the user. + Only set if detailed account information is requested. + See option DETAILED_ACCOUNTS for change queries + and option DETAILS for account queries."}, "email": {"type": "string", "description": "The email address the user prefers to be contacted through. + Only set if detailed account information is requested. + See option DETAILED_ACCOUNTS for change queries + and options DETAILS and ALL_EMAILS for account queries."}, "secondary_emails": {"type": "array", "items": {"type": "string"}, "description": "A list of the secondary email addresses of the user. + Only set for account queries when the ALL_EMAILS option or the suggest parameter is set. + Secondary emails are only included if the calling user has the Modify Account, and hence is allowed to see secondary emails of other users."}, "username": {"type": "string", "description": "The username of the user. + Only set if detailed account information is requested. + See option DETAILED_ACCOUNTS for change queries + and option DETAILS for account queries."}, "avatars": {"type": "array", "items": {"$ref": "#/components/schemas/AvatarInfo"}, "description": "List of AvatarInfo + entities that provide information about avatar images of the account."}, "_more_accounts": {"type": "boolean", "description": "Whether the query would deliver more results if not limited. + Only set on the last account that is returned."}, "status": {"type": "string", "description": "Status message of the account."}, "inactive": {"type": "boolean", "description": "Whether the account is inactive."}, "deleted": {"type": "boolean", "description": "Whether the account is deleted. + Only set if detailed account information is requested. + See option DETAILED_ACCOUNTS"}, "tags": {"type": "array", "items": {"type": "string"}, "description": "List of additional tags that this account has. The only + current tag an account can have is SERVICE_USER. + Only set if detailed account information is requested. + See option DETAILED_ACCOUNTS"}}},
      "AddMembersInput": {"type": "object", "properties": {"_one_member": {"type": "string", "description": "The id of one account that should be added or deleted."}, "members": {"type": "array", "items": {"type": "string"}, "description": "A list of account ids that identify the accounts that should be added or deleted."}}},
      "AddSubgroupsInput": {"type": "object", "properties": {"_one_group": {"type": "string", "description": "The id of one group that should be included or deleted."}, "groups": {"type": "array", "items": {"type": "string"}, "description": "A list of group ids that identify the groups that should be included or deleted."}}},
      "AvatarInfo": {"type": "object", "properties": {"url": {"type": "string", "description": "The URL to the avatar image."}, "height": {"type": "integer", "description": "The height of the avatar image in pixels."}}},
      "DescriptionInput": {"type": "object", "properties": {"description": {"type": "string", "description": "The description text."}}},
      "GroupAuditEventInfo": {"type": "object", "properties": {"type": {"$ref": "#/components/schemas/Type", "description": "The event type, can be: ADD_USER, REMOVE_USER, ADD_GROUP or REMOVE_GROUP. ADD_USER: A user was added as member to the group. REMOVE_USER: A user member was removed from the group. ADD_GROUP: A group was included as member in the group. REMOVE_GROUP: An included group was removed from the group."}, "user": {"$ref": "#/components/schemas/AccountInfo", "description": "The user that did the add/remove as detailed AccountInfo entity."}, "date": {"type": "string", "format": "gerrit-timestamp", "description": "The timestamp of the event."}}},
      "GroupInfo": {"type": "object", "properties": {"url": {"type": "string", "description": "URL to information about the group. Typically a URL to a web page that permits users to apply to join the group, or manage their membership."}, "options": {"$ref": "#/components/schemas/GroupOptionsInfo", "description": "Options of the group"}, "description": {"type": "string", "description": "The description of the group."}, "group_id": {"type": "integer", "description": "The numeric ID of the group."}, "owner": {"type": "string", "description": "The name of the owner group."}, "owner_id": {"type": "string", "description": "The URL encoded UUID of the owner group."}, "created_on": {"type": "string", "format": "gerrit-timestamp", "description": "The timestamp of when the group was created."}, "_more_groups": {"type": "boolean", "description": "Whether the query would deliver more results if not limited. + Only set on the last group that is returned by a group query."}, "members": {"type": "array", "items": {"$ref": "#/components/schemas/AccountInfo"}, "description": "A list of AccountInfo entities describing the direct members. + Only set if members are requested."}, "includes": {"type": "array", "items": {"$ref": "#/components/schemas/GroupInfo"}, "description": "A list of GroupInfo entities describing the direct subgroups. + Only set if subgroups are requested."}, "id": {"type": "string", "description": "The URL encoded UUID of the group."}, "name": {"type": "string", "description": "The name of the group. + For external groups the group name is missing if there is no group backend that can resolve the group UUID. E.g. this can happen when a plugin that provided a group backend was uninstalled."}}},
      "GroupInput": {"type": "object", "properties": {"name": {"type": "string", "description": "The name of the group (not encoded). + If set, must match the group name in the URL."}, "uuid": {"type": "string", "description": "The UUID of the group."}, "description": {"type": "string", "description": "The description of the group."}, "visible_to_all": {"type": "boolean", "description": "Whether the group is visible to all registered users. + false if not set."}, "owner_id": {"type": "string", "description": "The URL encoded ID of the owner group. + This can be a group UUID, a legacy numeric group ID or a unique group name. + If not set, the new group will be self-owned."}, "members": {"type": "array", "items": {"type": "string"}, "description": "The initial members in a list of + account ids."}}},
      "GroupOptionsInfo": {"type": "object", "properties": {"visible_to_all": {"type": "boolean", "description": "Whether the group is visible to all registered users."}}},
