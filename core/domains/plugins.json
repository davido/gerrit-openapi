{
  "openapi": "3.1.0",
  "info": {"title": "Gerrit Code Review REST API", "version": "3.15.0-SNAPSHOT", "description": "The Gerrit Code Review REST API. Paths, parameters, and payload schemas are generated statically from the server's REST bindings; human-authored summaries and descriptions are supplied here and merged in at build time.", "license": {"name": "Apache-2.0", "url": "https://www.apache.org/licenses/LICENSE-2.0"}},
  "servers": [{"url": "https://{host}", "description": "Anonymously accessible endpoints.", "variables": {"host": {"default": "gerrit-review.googlesource.com"}}}, {"url": "https://{host}/a", "description": "Authenticated endpoints (HTTP basic auth).", "variables": {"host": {"default": "gerrit-review.googlesource.com"}}}],
  "paths": {
    "/plugins": {"get": {"operationId": "getPlugins", "summary": "List Plugins", "description": "Lists the plugins installed on the Gerrit server. Only the enabled plugins are returned unless the all option is specified.", "tags": ["plugins"], "parameters": [{"name": "all", "in": "query", "schema": {"type": "boolean"}, "x-gerrit-aliases": ["a"]}, {"name": "limit", "in": "query", "schema": {"type": "integer"}, "x-gerrit-aliases": ["n"]}, {"name": "match", "in": "query", "schema": {"type": "string"}, "x-gerrit-aliases": ["m"]}, {"name": "prefix", "in": "query", "schema": {"type": "string"}, "x-gerrit-aliases": ["p"]}, {"name": "r", "in": "query", "schema": {"type": "string"}}, {"name": "start", "in": "query", "schema": {"type": "integer"}, "x-gerrit-aliases": ["S"]}], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": {"$ref": "#/components/schemas/PluginInfo"}}, "example": {"delete-project": {"id": "delete-project", "index_url": "plugins/delete-project/", "filename": "delete-project.jar", "api_version": "2.9.3-SNAPSHOT", "version": "2.9-SNAPSHOT"}}}}}}}},
    "/plugins/{plugin-id}": {"put": {"operationId": "putPluginsPluginId", "summary": "Install Plugin", "description": "Installs a new plugin on the Gerrit server. If a plugin with the specified name already exists it is overwritten. Note: if the plugin provides its own name in the MANIFEST file, then the plugin name from the MANIFEST file has precedence over the \\{plugin-id\\} above.", "tags": ["plugins"], "parameters": [{"name": "plugin-id", "in": "path", "required": true, "schema": {"type": "string"}}], "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/InstallPluginInput"}, "example": {"url": "file:///gerrit/plugins/delete-project/delete-project-2.8.jar"}}, "application/octet-stream": {"schema": {"type": "string", "format": "binary"}}}}, "responses": {"default": {"description": "Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PluginInfo"}, "example": {"id": "delete-project", "version": "v2.16-221-g35bb8bbac4", "index_url": "plugins/delete-project/", "filename": "delete-project.jar"}}}}}, "x-gerrit-bindings": [{"binding": "create(PLUGIN_KIND)", "view_fqcn": "com.google.gerrit.server.plugins.InstallPlugin.Create", "request_type": "InstallPluginInput", "request_representations": ["json", "raw"], "status_constant": null, "response_type": "PluginInfo"}, {"binding": "put(PLUGIN_KIND)", "view_fqcn": "com.google.gerrit.server.plugins.InstallPlugin.Overwrite", "request_type": "InstallPluginInput", "request_representations": ["json", "raw"], "status_constant": null, "response_type": "PluginInfo"}]}, "delete": {"operationId": "deletePluginsPluginId", "summary": "Disable Plugin", "description": "Disables a plugin on the Gerrit server.", "tags": ["plugins"], "parameters": [{"name": "plugin-id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PluginInfo"}, "example": {"id": "delete-project", "version": "2.8", "disabled": true}}}}}}},
    "/plugins/{plugin-id}/gerrit~disable": {"post": {"operationId": "postPluginsPluginIdGerritDisable", "summary": "Disable Plugin", "description": "Disables a plugin on the Gerrit server.", "tags": ["plugins"], "parameters": [{"name": "plugin-id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PluginInfo"}}}}}}},
    "/plugins/{plugin-id}/gerrit~enable": {"post": {"operationId": "postPluginsPluginIdGerritEnable", "summary": "Enable Plugin", "description": "Enables a plugin on the Gerrit server.", "tags": ["plugins"], "parameters": [{"name": "plugin-id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PluginInfo"}, "example": {"id": "delete-project", "version": "2.8"}}}}}}},
    "/plugins/{plugin-id}/gerrit~reload": {"post": {"operationId": "postPluginsPluginIdGerritReload", "summary": "Reload Plugin", "description": "Reloads a plugin on the Gerrit server.", "tags": ["plugins"], "parameters": [{"name": "plugin-id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PluginInfo"}, "example": {"id": "delete-project", "version": "2.8", "disabled": true}}}}}}},
    "/plugins/{plugin-id}/gerrit~status": {"get": {"operationId": "getPluginsPluginIdGerritStatus", "summary": "Get Plugin Status", "description": "Retrieves the status of a plugin on the Gerrit server.", "tags": ["plugins"], "parameters": [{"name": "plugin-id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PluginInfo"}, "example": {"id": "delete-project", "version": "2.8"}}}}}}}
  },
  "components": {
    "schemas": {
      "InstallPluginInput": {"type": "object", "properties": {"url": {"type": "string", "description": "URL to the plugin jar."}, "raw": {"$ref": "#/components/schemas/RawInput", "description": "The raw plugin content (the plugin jar) uploaded in the request body, as an alternative to url."}}},
      "PluginInfo": {"type": "object", "properties": {"id": {"type": "string", "description": "The ID of the plugin."}, "version": {"type": "string", "description": "The version of the plugin."}, "api_version": {"type": "string", "description": "The version of the Gerrit Api used by the plugin."}, "index_url": {"type": "string", "description": "URL of the plugin's default page."}, "filename": {"type": "string", "description": "The plugin's filename."}, "disabled": {"type": "boolean", "description": "Whether the plugin is disabled."}}},
      "RawInput": {"type": "object", "properties": {}}
    },
    "securitySchemes": {"basicAuth": {"type": "http", "scheme": "basic", "description": "HTTP basic auth with a username and a generated HTTP password."}}
  },
  "security": [{"basicAuth": []}],
  "tags": [{"name": "access", "description": "Project access rights."}, {"name": "accounts", "description": "Accounts, preferences, SSH keys, and capabilities."}, {"name": "changes", "description": "Changes, revisions, comments, reviewers, and edits."}, {"name": "config", "description": "Server configuration, caches, and tasks."}, {"name": "groups", "description": "Groups and their members."}, {"name": "projects", "description": "Projects, branches, tags, and dashboards."}, {"name": "plugins", "description": "Installed plugins."}]
}
